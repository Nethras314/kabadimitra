# =============================================================================
# KABADI MITRA — environment variable template (NO real values, NO secrets)
# Copy this file to `.env` (git-ignored) and fill in values per environment.
# Never commit real credentials. In production use each host's secret store
# (Render, Vercel, Supabase). No `.env` with secrets is ever committed.
# =============================================================================

# --- App ---
APP_ENV=development                # development | staging | production
APP_NAME=Kabadi Mitra
LOG_LEVEL=INFO

# --- Database (Supabase PostgreSQL + PostGIS) ---
# Prefer the SESSION POOLER string. The direct host db.<ref>.supabase.co is
# IPv6-only and is unreachable from many networks and from Render:
#   postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
# Note the username is `postgres.<project-ref>`, not just `postgres`.
DATABASE_URL=
DATABASE_URL_DIRECT=               # non-pooled (IPv6); only if your network supports it
DATABASE_POOL_URL=                 # optional pgbouncer/pooler URL

# --- Supabase (project + auth) ---
# Backend (server-side). SUPABASE_SECRET_KEY is the service-role key: it
# bypasses row-level security, so it must never reach a browser or be exposed
# to the client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Web (browser-visible). The Next.js client can ONLY read NEXT_PUBLIC_* names,
# so these are deliberately different from the backend variables above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Cloudinary (media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE_URL_PREFIX=

# --- Redis (cache / background jobs) ---
REDIS_URL=redis://localhost:6379/0

# --- AI (pluggable, assistive only — never authoritative) ---
AI_PROVIDER=none                   # none | reference | command_code
AI_API_KEY=
AI_MODEL=                          # e.g. google/gemini-3.5-flash-lite (vision-capable)
AI_BASE_URL=                       # e.g. https://api.commandcode.ai/provider/v1
AI_CONFIDENCE_THRESHOLD=0.80
AI_REVIEW_THRESHOLD=0.50
AI_TIMEOUT_SECONDS=30
AI_ZDR=true                        # send x-cmd-zdr: 1 (zero data retention)

# --- AUTH (Supabase JWT verification) ---
JWT_AUDIENCE=authenticated
JWT_ISSUER_SUFFIX=/auth/v1

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Web (Next.js / Vercel) ---
# The Next.js client reads ONLY NEXT_PUBLIC_* names, from web/.env.local
# (local) or the Vercel project environment (hosted). Defining these in the root
# .env has no effect on the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPLIBRE_TOKEN=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Account provisioning (backend/scripts/provision-accounts.mjs) ---
# Real values are supplied in the shell only; never committed.
PROVISION_ADMIN_EMAIL=admin@kabadi.local
PROVISION_COLLECTOR_EMAIL=collector@kabadi.local
PROVISION_ADMIN_PASSWORD=
PROVISION_COLLECTOR_PASSWORD=

# --- Mobile (Expo / Android) ---
# These are read by the Expo bundler at BUILD time (not runtime) and are
# inlined into the JS bundle, so only the publishable/anon key may ever appear
# here. NEVER put SUPABASE_SECRET_KEY in an EXPO_PUBLIC_* variable: it would be
# embedded in the shipped app and readable by anyone who unzips it.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Device note: on a physical device or emulator `localhost` points at the device
# itself, not your machine. Use your LAN IP (e.g. http://192.168.1.10:8000) or
# `adb reverse tcp:8000 tcp:8000` so the device can reach the backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Android emulator reaches the host loopback at 10.0.2.2:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# OpenStreetMap tile endpoint — no key required for standard OSM tiles.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
