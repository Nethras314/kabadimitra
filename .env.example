# =============================================================================
# KABADI MITRA — environment variable template (NO real values, NO secrets)
# Copy this file to `.env` (git-ignored) and fill in values per environment.
# Never commit real credentials. Keep production secrets in your host's secret
# manager (Render, Vercel, Supabase) or a local .env that is never committed.
# =============================================================================

# --- App ---
APP_ENV=development                # development | staging | production
APP_NAME=Kabadi Mitra
LOG_LEVEL=INFO

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Secret for signing auth tokens — generate a strong random value.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of supported locales, in priority order.
SUPPORTED_LOCALES=hi,en,mr,ta,te,ml,kn,bn

# --- Supabase ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- Database (Supabase PostgreSQL + PostGIS) ---
# Connection string for the Supabase PostgreSQL instance (with PostGIS enabled).
# Use the DIRECT or SESSION pooler connection (port 5432) for migrations.
DATABASE_URL=
# Direct connection (non-pooled) for migrations, if using Supabase pooler.
DATABASE_URL_DIRECT=
# Optional pgbouncer/pooler URL for runtime queries.
DATABASE_POOL_URL=

# --- Object / media storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE_URL_PREFIX=

# --- Cache / background jobs (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- AI / classification service (pluggable) ---
# Backend AI is assistive only — never authoritative. Human confirmation required
# for uncertain classifications. Provider is pluggable; leave empty to run
# without an AI backend (manual classification only).
AI_PROVIDER=                      # e.g. openai | anthropic | self-hosted | none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_CONFIDENCE_THRESHOLD=0.80      # Above this => suggest with collector confirm
AI_REVIEW_THRESHOLD=0.50          # Below this => route for recycler/admin review

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPLIBRE_TOKEN=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Mobile (Expo / React Native) ---
# Set in Expo config / EAS secrets; listed here for documentation completeness.
EXPO_PUBLIC_API_URL=http://localhost:8000
# OpenStreetMap tile endpoint — no key required for standard OSM tiles.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
