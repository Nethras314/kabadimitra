# -----------------------------------------------------------------------------
# KABADI MITRA — mobile (Expo) environment template. NO real values, NO secrets.
#
# Copy to `.env` (git-ignored) and fill in per environment:
#   cp .env.example .env
#
# IMPORTANT: Expo loads this file from the `mobile/` directory, NOT the repo
# root. Variables defined in the root `.env` are for the backend and are not
# visible to the mobile bundler, which is why the app previously fell back to
# its hardcoded localhost default and could never authenticate.
#
# SECURITY: EXPO_PUBLIC_* values are INLINED INTO THE SHIPPED JS BUNDLE at build
# time. Only ever put the publishable / anon key here. Never put
# SUPABASE_SECRET_KEY (service-role) in an EXPO_PUBLIC_* variable — it would be
# readable by anyone who unpacks the app.
# -----------------------------------------------------------------------------

# Base URL of the Kabadi Mitra backend.
# Physical device / emulator: `localhost` resolves to the DEVICE, not your
# machine. Either use your LAN IP or run `adb reverse tcp:8000 tcp:8000`.
# Android emulator host loopback is 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase project used for Auth. The publishable key is the anon/public key
# (safe for a client); the secret key must never appear in this file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenStreetMap tile endpoint — no key required for standard OSM tiles.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
